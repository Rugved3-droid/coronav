cff-version: 1.2.0
message: "If you use CoroNav, please cite the following."

references:
  - type: software
    authors:
      - family-names: Karstensen
        given-names: Lennart
    title: "stEVE: Simulation framework for endovascular environments"
    url: "https://github.com/lkarstensen/stEVE"

  - type: article
    authors:
      - family-names: Wilson
        given-names: Nathan
    title: "The Vascular Model Repository: A Public Resource of Medical Imaging Data and Blood Flow Simulation Results"
    year: 2013
    journal: "Journal of Medical Devices"
    doi: "10.1115/1.4025983"
    notes: >
      Required citation for VMR0066 anatomy data bundled with CoroNav (A1).

  - type: article
    authors:
      - family-names: Gharleghi
        given-names: Ramtin
    title: "Annotated computed tomography coronary angiogram images and associated data of normal and diseased arteries"
    year: 2023
    journal: "Scientific Data"
    volume: 10
    start: 128
    doi: "10.1038/s41597-023-02016-2"
    notes: >
      Required citation for the ASOCA case used as A2 (Normal_12; not bundled).
      Reference as cited in the manuscript.

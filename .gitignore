# Secrets — never commit
.env
*.key
*.secret

# Run outputs — large and user-specific
runs/
outputs/
results/
*.jsonl
# Original research artifacts (episode traces etc.) are meant to be committed
# under artifacts/ — see docs/MANUSCRIPT_CONCORDANCE.md.
!artifacts/**/*.jsonl
!artifacts/results/

# Registration-gated ASOCA anatomy (A2; excluded A3) — must never be
# redistributed. Only the bundled A1 is committed.
data/anatomy/a2_asoca_n12/
data/anatomy/a3_asoca_n5/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
.venv/
venv/
env/

# SOFA / simulation
*.sofa
*.log
*.tmp

# Large binary data — anatomy data is committed intentionally (see data/)
# but raw downloaded datasets stay local
ASOCADataAccess.zip
*.zip
*.tar.gz

# Jupyter
.ipynb_checkpoints/
*.ipynb

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
